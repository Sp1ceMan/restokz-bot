# RestoKZ Environment Variables
# Copy this file to .env for local development
# On Railway — set these in the Dashboard → Variables tab

# =============================================================
# REQUIRED
# =============================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# =============================================================
# OPTIONAL (have sensible defaults)
# =============================================================

# Your Netlify frontend URL
WEBAPP_URL=https://restaurant-reserv.netlify.app

# Your Telegram admin/restaurant user ID (from @userinfobot)
ADMIN_CHAT_ID=348581961

# Port for the HTTP API server (Railway sets PORT automatically)
PORT=8080

# Path to SQLite database file
# Railway: set to /data/booking.db (persistent volume mounted at /data)
# Local:   leave empty — defaults to ./booking.db next to bot.py
DATABASE_PATH=

# Your public API URL (used by bot to build WebApp links)
# Railway: set to your railway domain, e.g. https://restokz-api.up.railway.app
# Local:   leave empty — tunnel URL is used automatically
TUNNEL_URL=
